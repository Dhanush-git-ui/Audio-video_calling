{
  "buildCommand": "bash vercel-build.sh",
  "outputDirectory": ".",
  "env": {
    "NODE_OPTIONS": "--experimental-modules"
  },
  "functions": {
    "server.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
